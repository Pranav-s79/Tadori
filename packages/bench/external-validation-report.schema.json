{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Ordering and cross-field success invariants are additionally enforced by the runtime Zod schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "manifestVersion",
    "recordedAt",
    "validator",
    "success",
    "repositories"
  ],
  "properties": {
    "$schema": { "const": "./external-validation-report.schema.json" },
    "schemaVersion": { "const": 1 },
    "manifestVersion": { "const": 1 },
    "recordedAt": { "type": "string", "format": "date-time" },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "sourceChanges"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sourceChanges": { "type": "boolean" }
      }
    },
    "success": { "type": "boolean" },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "repositoryId",
          "url",
          "license",
          "purpose",
          "expectedCommit",
          "observedCommit",
          "success",
          "graphDigest",
          "workspaceHash",
          "analyzerVersion",
          "counts",
          "languages",
          "extractors",
          "error",
          "invariants"
        ],
        "properties": {
          "status": { "enum": ["completed", "failed"] },
          "repositoryId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "url": { "type": "string", "format": "uri" },
          "license": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "expectedCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "observedCommit": {
            "anyOf": [
              { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              { "type": "null" }
            ]
          },
          "success": { "type": "boolean" },
          "graphDigest": {
            "anyOf": [
              { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              { "type": "null" }
            ]
          },
          "workspaceHash": {
            "anyOf": [
              { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              { "type": "null" }
            ]
          },
          "analyzerVersion": {
            "anyOf": [
              { "type": "string", "minLength": 1 },
              { "type": "null" }
            ]
          },
          "counts": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["files", "nodes", "edges", "projects", "diagnostics", "errorDiagnostics"],
                "properties": {
                  "files": { "type": "integer", "minimum": 0 },
                  "nodes": { "type": "integer", "minimum": 0 },
                  "edges": { "type": "integer", "minimum": 0 },
                  "projects": { "type": "integer", "minimum": 0 },
                  "diagnostics": { "type": "integer", "minimum": 0 },
                  "errorDiagnostics": { "type": "integer", "minimum": 0 }
                }
              },
              { "type": "null" }
            ]
          },
          "languages": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
          },
          "extractors": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "version", "capability", "languages"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 },
                "capability": { "enum": ["semantic", "structural", "repository"] },
                "languages": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "error": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "message"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "message": { "type": "string", "minLength": 1 }
                }
              },
              { "type": "null" }
            ]
          },
          "invariants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "passed", "detail"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "passed": { "type": "boolean" },
                "detail": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
            "then": {
              "properties": {
                "success": { "const": false },
                "graphDigest": { "type": "null" },
                "workspaceHash": { "type": "null" },
                "analyzerVersion": { "type": "null" },
                "counts": { "type": "null" },
                "languages": { "type": "array", "maxItems": 0 },
                "extractors": { "type": "array", "maxItems": 0 },
                "error": { "type": "object" }
              }
            },
            "else": {
              "properties": {
                "observedCommit": { "type": "string" },
                "graphDigest": { "type": "string" },
                "workspaceHash": { "type": "string" },
                "analyzerVersion": { "type": "string" },
                "counts": { "type": "object" },
                "error": { "type": "null" }
              }
            }
          }
        ]
      }
    }
  }
}
