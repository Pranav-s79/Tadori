{
  "name": "tadori",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "@hono/node-server@<2.0.5": "2.0.12",
      "fast-uri@>=3.0.0 <3.1.6": "3.1.6",
      "fast-uri@>=4.0.0 <4.1.3": "4.1.3",
      "find-my-way@>=9.0.0 <9.7.0": "9.7.0",
      "hono@<4.13.5": "4.13.5",
      "ip-address@<10.3.1": "10.3.1",
      "qs@<6.16.0": "6.16.0"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "pnpm --filter @tadori/viz build && vitest run --exclude=packages/cli/test/**/*.test.ts && vitest run packages/cli/test --pool=forks --maxWorkers=1 --no-file-parallelism && pnpm --filter @tadori/viz test",
    "package:artifact": "pnpm --filter @tadori/viz build && node scripts/build-package.mjs",
    "mcp:stdio": "tsx packages/mcp/src/cli.ts",
    "tadori": "tsx scripts/tadori.mts",
    "capture": "pnpm --filter @tadori/viz build && tsx scripts/capture.mts"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@types/node": "^20.14.0",
    "axe-core": "4.12.1",
    "esbuild": "0.28.1",
    "eslint": "^9.7.0",
    "playwright-core": "1.62.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
